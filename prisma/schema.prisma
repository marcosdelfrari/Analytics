// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  client
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       Role     @default(client)
  planActive Boolean  @default(false) @map("plan_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  trackingSite TrackingSite?

  @@map("users")
}

// Um site de coleta por cliente (conta); a chave pública isola hits e métricas.
model TrackingSite {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  publicKey String   @unique @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]
  dailyMetrics TrackingDailyMetric[]
  eventDailyMetrics TrackingEventDailyMetric[]
  campaignDailyMetrics TrackingCampaignDailyMetric[]
  allowedDomains TrackingAllowedDomain[]

  @@map("tracking_sites")
}

model TrackingAllowedDomain {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  host      String
  createdAt DateTime @default(now()) @map("created_at")
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, host])
  @@index([siteId])
  @@map("tracking_allowed_domains")
}

model TrackingHit {
  id            String    @id @default(uuid())
  clientEventId String?   @map("client_event_id")
  siteId        String    @map("site_id")
  kind          String
  name          String
  url           String
  path          String
  referrer      String    @default("")
  params        Json
  properties    Json
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  site          TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, clientEventId])
  @@index([siteId, createdAt])
  @@index([processedAt, createdAt])
  @@map("tracking_hits")
}

model TrackingDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day])
  @@map("tracking_daily_metrics")
}

model TrackingEventDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName])
  @@map("tracking_event_daily_metrics")
}

model TrackingCampaignDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, campaign])
  @@map("tracking_campaign_daily_metrics")
}
