// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["dbo", "leads", "tracking", "marketing", "public"]
}

enum Role {
  system_admin @map("admin")
  client

  @@schema("dbo")
}

enum CompanyAccessRole {
  proprietario @map("administrator")
  analista @map("analyst")

  @@map("company_access_role")
  @@schema("dbo")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  /// Null = conta só Google (ou legado). Não apaga dados existentes.
  passwordHash String?  @map("password_hash")
  role       Role     @default(client)
  planActive Boolean  @default(false) @map("plan_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("cad_usuario")
  @@schema("dbo")
}

model AppMeta {
  key   String @id
  value String

  @@map("cfg_parametro")
  @@schema("dbo")
}

model LoginOtp {
  email        String   @id
  codeHash     String   @map("code_hash")
  expiresAt    DateTime @map("expires_at")
  attemptCount Int      @default(0) @map("attempt_count")

  @@map("aux_login_otp")
  @@schema("dbo")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  companies    Company[]
  accessGrants AccessGrant[]
  leadForms       LeadForm[]
  leadSubmissions LeadSubmission[]

  @@map("cad_organizacao")
  @@schema("dbo")
}

model Company {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  planActive     Boolean              @default(false) @map("plan_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingSite   TrackingSite?
  grantLinks     AccessGrantCompany[]
  leadForms       LeadForm[]
  leadSubmissions LeadSubmission[]
  shortLinks      ShortLink[]
  publishedReports PublishedReport[]

  @@index([organizationId])
  @@map("cad_empresa")
  @@schema("dbo")
}

enum LeadFormKind {
  whatsapp_button
  popup
  exit_intent
  section

  @@schema("leads")
}

/// Formulário de captura de lead montado pelo proprietário da organização.
model LeadForm {
  id                       String       @id @default(uuid())
  organizationId           String       @map("organization_id")
  companyId                String?      @map("company_id")
  name                     String
  kind                     LeadFormKind
  title                    String       @default("")
  subtitle                 String       @default("")
  ctaLabel                 String       @default("Enviar") @map("cta_label")
  whatsappNumber           String       @default("") @map("whatsapp_number")
  whatsappMessage          String       @default("") @map("whatsapp_message")
  /// Definição dos campos: [{ id, label, type, required, placeholder?, options? }]
  fields                   Json
  sendConfirmationEmail    Boolean      @default(false) @map("send_confirmation_email")
  confirmationEmailSubject String       @default("") @map("confirmation_email_subject")
  confirmationEmailBody    String       @default("") @map("confirmation_email_body")
  active                   Boolean      @default(true)
  brandLogoUrl             String       @default("") @map("brand_logo_url")
  brandAccentColor         String       @default("") @map("brand_accent_color")
  brandHeaderImageUrl      String       @default("") @map("brand_header_image_url")
  brandTheme               String       @default("dark") @map("brand_theme")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company                  Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions              LeadSubmission[]

  @@index([organizationId])
  @@index([companyId])
  @@map("cad_formulario")
  @@schema("leads")
}

model LeadSubmission {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  companyId      String?      @map("company_id")
  formId         String       @map("form_id")
  fields         Json
  pageUrl        String       @default("") @map("page_url")
  referrer       String       @default("")
  utmSource      String       @default("") @map("utm_source")
  utmMedium      String       @default("") @map("utm_medium")
  utmCampaign    String       @default("") @map("utm_campaign")
  utmContent     String       @default("") @map("utm_content")
  utmTerm        String       @default("") @map("utm_term")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  form           LeadForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([formId, createdAt])
  @@map("mov_submissao")
  @@schema("leads")
}

model AccessGrant {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  email          String
  allCompanies   Boolean              @default(true) @map("all_companies")
  isOrgProprietario Boolean           @default(false) @map("is_owner")
  createdAt      DateTime             @default(now()) @map("created_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies      AccessGrantCompany[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("cad_acesso")
  @@schema("dbo")
}

model AccessGrantCompany {
  grantId   String             @map("grant_id")
  companyId String             @map("company_id")
  role      CompanyAccessRole  @default(analista)
  grant     AccessGrant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([grantId, companyId])
  @@map("cad_acesso_empresa")
  @@schema("dbo")
}

// Um site de coleta por empresa; a chave pública isola hits e métricas.
model TrackingSite {
  id        String   @id @default(uuid())
  companyId String   @unique @map("company_id")
  publicKey String   @unique @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]
  dailyMetrics TrackingDailyMetric[]
  eventDailyMetrics TrackingEventDailyMetric[]
  campaignDailyMetrics TrackingCampaignDailyMetric[]
  attributionDailyMetrics TrackingAttributionDailyMetric[]
  eventPlatformDailyMetrics TrackingEventPlatformDailyMetric[]
  pathDailyMetrics TrackingPathDailyMetric[]
  pathFlowDailyMetrics TrackingPathFlowDailyMetric[]
  deviceDailyMetrics TrackingDeviceDailyMetric[]
  visitorDaily TrackingVisitorDaily[]
  allowedDomains TrackingAllowedDomain[]

  @@map("cad_site")
  @@schema("tracking")
}

model TrackingAllowedDomain {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  host      String
  createdAt DateTime @default(now()) @map("created_at")
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, host])
  @@index([siteId])
  @@map("cad_dominio_permitido")
  @@schema("tracking")
}

model TrackingHit {
  id            String    @id @default(uuid())
  clientEventId String?   @map("client_event_id")
  visitorId     String?   @map("visitor_id")
  siteId        String    @map("site_id")
  kind          String
  name          String
  url           String
  path          String
  referrer      String    @default("")
  params        Json
  properties    Json
  browser       String    @default("")
  os            String    @default("")
  deviceType    String    @default("") @map("device_type")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  site          TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, clientEventId])
  @@index([siteId, createdAt])
  @@index([processedAt, createdAt])
  @@index([siteId, visitorId, createdAt])
  @@map("mov_hit")
  @@schema("tracking")
}

model TrackingDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  pageviews Int      @default(0)
  events    Int      @default(0)
  visitors  Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day])
  @@map("agr_metrica_dia")
  @@schema("tracking")
}

model TrackingVisitorDaily {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  visitorId String   @map("visitor_id")
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, visitorId])
  @@index([siteId, day])
  @@map("agr_visitante_dia")
  @@schema("tracking")
}

model TrackingEventDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName])
  @@map("agr_evento_dia")
  @@schema("tracking")
}

model TrackingCampaignDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, campaign])
  @@map("agr_campanha_dia")
  @@schema("tracking")
}

model TrackingAttributionDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  source    String
  medium    String
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, source, medium, campaign])
  @@map("agr_atribuicao_dia")
  @@schema("tracking")
}

model TrackingEventPlatformDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  platform  String
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName, platform])
  @@map("agr_evento_plataforma_dia")
  @@schema("tracking")
}

model TrackingPathDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  path      String
  pageviews Int      @default(0)
  events    Int      @default(0)
  landings  Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, path])
  @@map("agr_pagina_dia")
  @@schema("tracking")
}

model TrackingPathFlowDailyMetric {
  siteId   String   @map("site_id")
  day      DateTime @db.Date
  fromPath String   @map("from_path")
  path     String
  count    Int      @default(0)
  site     TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, fromPath, path])
  @@map("agr_fluxo_pagina_dia")
  @@schema("tracking")
}

model TrackingDeviceDailyMetric {
  siteId     String   @map("site_id")
  day        DateTime @db.Date
  deviceType String   @map("device_type")
  browser    String
  os         String
  pageviews  Int      @default(0)
  events     Int      @default(0)
  site       TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, deviceType, browser, os])
  @@map("agr_dispositivo_dia")
  @@schema("tracking")
}

model ShortLink {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  code      String   @unique
  url       String
  label     String   @default("")
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("cad_link_curto")
  @@schema("marketing")
}

model PublishedReport {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  platform        String
  period          String
  spend           Float
  spendChange     Float?   @map("spend_change")
  impressions     Int
  clicks          Int
  conversions     Int
  activeCampaigns Int?     @map("active_campaigns")
  totalCampaigns  Int?     @map("total_campaigns")
  notes           String   @default("")
  fileName        String?  @map("file_name")
  storedFile      String?  @map("stored_file")
  publishedAt     DateTime @map("published_at")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publishedAt])
  @@map("mov_relatorio_publicado")
  @@schema("marketing")
}

enum ProposalStatus {
  draft
  requested
  sent
  accepted
  cancelled

  @@schema("public")
}

enum MarketingPlanStatus {
  draft
  saved

  @@schema("public")
}

/// Proposta comercial Lótus (schema public). userId → dbo.cad_usuario.id, sem FK.
model TrafficProposal {
  id                 String         @id @default(uuid())
  userId             String         @map("user_id")
  clientEmail        String         @default("") @map("client_email")
  clientName         String         @default("") @map("client_name")
  companyName        String         @map("company_name")
  segment            String         @default("")
  monthlyMediaBudget Int?           @map("monthly_media_budget")
  goals              String         @default("")
  contactPhone       String         @default("") @map("contact_phone")
  intro              String         @default("")
  title              String?
  scope              Json           @default("[]")
  services           Json           @default("[]")
  setupFee           Int?           @map("setup_fee")
  adBudgetSuggestion Int?           @map("ad_budget_suggestion")
  deadlineDays       Int?           @map("deadline_days")
  implementationPlan Json           @default("[]") @map("implementation_plan")
  conditions         Json           @default("[]")
  terms              Json           @default("[]")
  validUntil         DateTime?      @map("valid_until") @db.Date
  status             ProposalStatus @default(requested)
  acceptedAt         DateTime?      @map("accepted_at")
  acceptance         Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  marketingPlans     MarketingPlan[]

  @@index([userId])
  @@index([clientEmail])
  @@map("traffic_proposals")
  @@schema("public")
}

/// Plano de marketing por proposta aceita; analyticsCompanyId → dbo.cad_empresa.id, sem FK.
model MarketingPlan {
  id                 String              @id @default(uuid())
  proposalId         String              @map("proposal_id")
  analyticsCompanyId String              @map("analytics_company_id")
  operationProposal  String              @map("operation_proposal")
  funnelTouchpoints  String[]            @default([]) @map("funnel_touchpoints")
  mediaChannels      String[]            @default([]) @map("media_channels")
  adFormats          String[]            @default([]) @map("ad_formats")
  notes              String              @default("")
  customAssets       String              @default("") @map("custom_assets")
  status             MarketingPlanStatus @default(saved)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  proposal           TrafficProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, analyticsCompanyId])
  @@index([proposalId])
  @@map("marketing_plans")
  @@schema("public")
}
