// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  client
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       Role     @default(client)
  planActive Boolean  @default(false) @map("plan_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model LoginOtp {
  email     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")

  @@map("login_otps")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  companies    Company[]
  accessGrants AccessGrant[]

  @@map("organizations")
}

model Company {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  planActive     Boolean              @default(false) @map("plan_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingSite   TrackingSite?
  grantLinks     AccessGrantCompany[]

  @@index([organizationId])
  @@map("companies")
}

model AccessGrant {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  email          String
  allCompanies   Boolean              @default(true) @map("all_companies")
  isOwner        Boolean              @default(false) @map("is_owner")
  createdAt      DateTime             @default(now()) @map("created_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies      AccessGrantCompany[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("access_grants")
}

model AccessGrantCompany {
  grantId   String      @map("grant_id")
  companyId String      @map("company_id")
  grant     AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([grantId, companyId])
  @@map("access_grant_companies")
}

// Um site de coleta por empresa; a chave pública isola hits e métricas.
model TrackingSite {
  id        String   @id @default(uuid())
  companyId String   @unique @map("company_id")
  publicKey String   @unique @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]
  dailyMetrics TrackingDailyMetric[]
  eventDailyMetrics TrackingEventDailyMetric[]
  campaignDailyMetrics TrackingCampaignDailyMetric[]
  allowedDomains TrackingAllowedDomain[]

  @@map("tracking_sites")
}

model TrackingAllowedDomain {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  host      String
  createdAt DateTime @default(now()) @map("created_at")
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, host])
  @@index([siteId])
  @@map("tracking_allowed_domains")
}

model TrackingHit {
  id            String    @id @default(uuid())
  clientEventId String?   @map("client_event_id")
  siteId        String    @map("site_id")
  kind          String
  name          String
  url           String
  path          String
  referrer      String    @default("")
  params        Json
  properties    Json
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  site          TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, clientEventId])
  @@index([siteId, createdAt])
  @@index([processedAt, createdAt])
  @@map("tracking_hits")
}

model TrackingDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day])
  @@map("tracking_daily_metrics")
}

model TrackingEventDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName])
  @@map("tracking_event_daily_metrics")
}

model TrackingCampaignDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, campaign])
  @@map("tracking_campaign_daily_metrics")
}
