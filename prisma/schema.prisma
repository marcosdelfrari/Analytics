// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  client
}

enum CompanyAccessRole {
  administrator
  analyst

  @@map("company_access_role")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  /// Null = conta só Google (ou legado). Não apaga dados existentes.
  passwordHash String?  @map("password_hash")
  role       Role     @default(client)
  planActive Boolean  @default(false) @map("plan_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AppMeta {
  key   String @id
  value String

  @@map("app_meta")
}

model LoginOtp {
  email        String   @id
  codeHash     String   @map("code_hash")
  expiresAt    DateTime @map("expires_at")
  attemptCount Int      @default(0) @map("attempt_count")

  @@map("login_otps")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  companies    Company[]
  accessGrants AccessGrant[]
  leadForms       LeadForm[]
  leadSubmissions LeadSubmission[]

  @@map("organizations")
}

model Company {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  planActive     Boolean              @default(false) @map("plan_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingSite   TrackingSite?
  grantLinks     AccessGrantCompany[]
  leadForms       LeadForm[]
  leadSubmissions LeadSubmission[]
  shortLinks      ShortLink[]
  publishedReports PublishedReport[]

  @@index([organizationId])
  @@map("companies")
}

enum LeadFormKind {
  whatsapp_button
  popup
  exit_intent
}

/// Formulário de captura de lead montado pelo proprietário da organização.
model LeadForm {
  id                       String       @id @default(uuid())
  organizationId           String       @map("organization_id")
  companyId                String?      @map("company_id")
  name                     String
  kind                     LeadFormKind
  title                    String       @default("")
  subtitle                 String       @default("")
  ctaLabel                 String       @default("Enviar") @map("cta_label")
  whatsappNumber           String       @default("") @map("whatsapp_number")
  whatsappMessage          String       @default("") @map("whatsapp_message")
  /// Definição dos campos: [{ id, label, type, required, placeholder?, options? }]
  fields                   Json
  sendConfirmationEmail    Boolean      @default(false) @map("send_confirmation_email")
  confirmationEmailSubject String       @default("") @map("confirmation_email_subject")
  confirmationEmailBody    String       @default("") @map("confirmation_email_body")
  active                   Boolean      @default(true)
  brandLogoUrl             String       @default("") @map("brand_logo_url")
  brandAccentColor         String       @default("") @map("brand_accent_color")
  brandHeaderImageUrl      String       @default("") @map("brand_header_image_url")
  brandTheme               String       @default("dark") @map("brand_theme")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company                  Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions              LeadSubmission[]

  @@index([organizationId])
  @@index([companyId])
  @@map("lead_forms")
}

model LeadSubmission {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  companyId      String?      @map("company_id")
  formId         String       @map("form_id")
  fields         Json
  pageUrl        String       @default("") @map("page_url")
  referrer       String       @default("")
  utmSource      String       @default("") @map("utm_source")
  utmMedium      String       @default("") @map("utm_medium")
  utmCampaign    String       @default("") @map("utm_campaign")
  utmContent     String       @default("") @map("utm_content")
  utmTerm        String       @default("") @map("utm_term")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  form           LeadForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([formId, createdAt])
  @@map("lead_submissions")
}

model AccessGrant {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  email          String
  allCompanies   Boolean              @default(true) @map("all_companies")
  isOwner        Boolean              @default(false) @map("is_owner")
  createdAt      DateTime             @default(now()) @map("created_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies      AccessGrantCompany[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("access_grants")
}

model AccessGrantCompany {
  grantId   String             @map("grant_id")
  companyId String             @map("company_id")
  role      CompanyAccessRole  @default(analyst)
  grant     AccessGrant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([grantId, companyId])
  @@map("access_grant_companies")
}

// Um site de coleta por empresa; a chave pública isola hits e métricas.
model TrackingSite {
  id        String   @id @default(uuid())
  companyId String   @unique @map("company_id")
  publicKey String   @unique @map("public_key")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]
  dailyMetrics TrackingDailyMetric[]
  eventDailyMetrics TrackingEventDailyMetric[]
  campaignDailyMetrics TrackingCampaignDailyMetric[]
  attributionDailyMetrics TrackingAttributionDailyMetric[]
  eventPlatformDailyMetrics TrackingEventPlatformDailyMetric[]
  allowedDomains TrackingAllowedDomain[]

  @@map("tracking_sites")
}

model TrackingAllowedDomain {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  host      String
  createdAt DateTime @default(now()) @map("created_at")
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, host])
  @@index([siteId])
  @@map("tracking_allowed_domains")
}

model TrackingHit {
  id            String    @id @default(uuid())
  clientEventId String?   @map("client_event_id")
  siteId        String    @map("site_id")
  kind          String
  name          String
  url           String
  path          String
  referrer      String    @default("")
  params        Json
  properties    Json
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  site          TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, clientEventId])
  @@index([siteId, createdAt])
  @@index([processedAt, createdAt])
  @@map("tracking_hits")
}

model TrackingDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day])
  @@map("tracking_daily_metrics")
}

model TrackingEventDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName])
  @@map("tracking_event_daily_metrics")
}

model TrackingCampaignDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, campaign])
  @@map("tracking_campaign_daily_metrics")
}

model TrackingAttributionDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  source    String
  medium    String
  campaign  String
  pageviews Int      @default(0)
  events    Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, source, medium, campaign])
  @@map("tracking_attribution_daily_metrics")
}

model TrackingEventPlatformDailyMetric {
  siteId    String   @map("site_id")
  day       DateTime @db.Date
  eventName String   @map("event_name")
  platform  String
  count     Int      @default(0)
  site      TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, day, eventName, platform])
  @@map("tracking_event_platform_daily_metrics")
}

model ShortLink {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  code      String   @unique
  url       String
  label     String   @default("")
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("short_links")
}

model PublishedReport {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  platform        String
  period          String
  spend           Float
  spendChange     Float?   @map("spend_change")
  impressions     Int
  clicks          Int
  conversions     Int
  activeCampaigns Int?     @map("active_campaigns")
  totalCampaigns  Int?     @map("total_campaigns")
  notes           String   @default("")
  fileName        String?  @map("file_name")
  storedFile      String?  @map("stored_file")
  publishedAt     DateTime @map("published_at")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publishedAt])
  @@map("published_reports")
}
