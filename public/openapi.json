{
  "openapi": "3.1.0",
  "info": {
    "title": "Fractal",
    "version": "1.0.0",
    "summary": "API pública da Fractal para status e descoberta.",
    "description": "Superfície pública da Fractal. A autenticação, o painel e o encurtador não fazem parte deste contrato."
  },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "google": {
        "type": "openIdConnect",
        "openIdConnectUrl": "/.well-known/openid-configuration",
        "description": "Login com Google via authorization code. O emissor, os endpoints e o JWKS estão no documento de descoberta."
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Status da API",
        "responses": {
          "200": {
            "description": "Serviço disponível",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    }
  }
}
